{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nodal",
  "version": "1.0.0",
  "identifier": "io.github.jpmarcelino.nodal",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Nodal",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Circuit & schematic designer",
    "longDescription": "Nodal is a fast, beautiful schematic and circuit designer with a large symbol library, custom symbols, smart wiring and exports to PNG, SVG, DXF, SPICE and BOM.",
    "copyright": "© 2026 JPMarcelino — MIT licensed",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": { "installMode": "currentUser" }
    }
  }
}
